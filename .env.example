# Supabase project credentials — find them at
# https://supabase.com/dashboard/project/_/settings/api
# Copy this file to .env and fill in the values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI coach — Google Gemini (server-side only, never NEXT_PUBLIC / never
# committed / never logged). Get a free key at https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the model (default gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
